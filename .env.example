MYSQL_ROOT_PASSWORD=cambiar_root
MYSQL_DATABASE=seguros_castano
MYSQL_USER=app
MYSQL_PASSWORD=cambiar_app

# Groq (API compatible con OpenAI): elige la intención de cada mensaje y redacta las plantillas.
# La clave sale de console.groq.com y no se sube al repo. Sin una clave válida, el asistente deriva toda consulta.
AI_API_URL=https://api.groq.com/openai/v1
AI_API_KEY=cambiar_api_key
AI_MODEL=openai/gpt-oss-20b

# WhatsApp por WAHA, servicio no oficial que corre con el perfil "whatsapp" del compose (ver README).
# El backend las necesita aunque no levantes waha. Si lo levantás, cambiá los valores de ejemplo: el repo es público.
# Dirección de WAHA adentro de la red del compose.
WHATSAPP_API_URL=http://waha:3000
# Clave de la API de WAHA: el backend la manda en el header X-Api-Key y el compose se la pasa a WAHA.
WHATSAPP_API_KEY=cambiar_clave_waha
# Secreto que WAHA manda al backend en cada aviso (header X-Webhook-Secret). Sin ":" ni ";".
WHATSAPP_WEBHOOK_SECRET=cambiar_secreto_webhook
# Usuario del dashboard de WAHA (http://localhost:8080/dashboard). Sin ":" ni ";".
WAHA_DASHBOARD_USERNAME=cambiar_usuario
# Contraseña del dashboard. Sin ":" ni ";". WAHA trata admin, waha, 123 y 00..00 como inseguras y las cambia por una al azar.
WAHA_DASHBOARD_PASSWORD=cambiar_contrasena
